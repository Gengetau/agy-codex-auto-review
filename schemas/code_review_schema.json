        "required": ["severity", "file", "title", "detail"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["p0", "p1", "p2", "p3"]
          },
          "file": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
